PORT=
DATABASE_URL=your-production-database-url
JWT_SECRET=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=
NODE_ENV=
# Comma-separated origins only, without paths. Example:
# FRONTEND_URL=https://your-deployed-frontend.example,http://localhost:3000
FRONTEND_URL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=mercytcollege@gmail.com
# Use a Google App Password with spaces removed; keep real credentials in .env only.
SMTP_PASSWORD=your_google_app_password_here
# Optional sender override; when set, keep it aligned with SMTP_FROM.
SMTP_MAIL=
SMTP_FROM=mercytcollege@gmail.com
# Mailgun is used for transactional email when all three required values are set.
MAILGUN_API_KEY=
MAILGUN_FROM_EMAIL=Mercy T International College <noreply@mg.example.com>
MAILGUN_DOMAIN=mg.example.com
MAILGUN_REGION=us
# Optional Klaviyo profile subscription integration.
KLAVIYO_PRIVATE_API_KEY=
KLAVIYO_LIST_ID=
MAILER_TEST_RECIPIENT=
UPLOAD_DIR=
ENABLE_JOBS=true
JOBS_INTERVAL_MS=900000
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MEDIA_BUCKET=school-media
SUPABASE_DOCUMENT_BUCKET=school-documents
SUPABASE_SIGNED_URL_TTL_SECONDS=3600
MAX_UPLOAD_SIZE_BYTES=5242880
# Web Push phone alerts. Generate a pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
